{
  "name": "camera-ai",
  "displayName": "Camera AI",
  "description": "The Ontological Genesis Fabric IDE",
  "version": "0.0.1",
  "publisher": "camera-ai-founder",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onCommand:camera-ai.analyze"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "camera-ai.analyze",
        "title": "Camera AI: Analyze Highlighted Code"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}