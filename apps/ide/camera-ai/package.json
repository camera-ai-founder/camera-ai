{
  "name": "dna-mutator",
  "displayName": "DNA Mutator",
  "description": "The Anti-IDE Reality Editor. We reject the Old Paradigm.",
  "version": "0.0.1",
  "publisher": "founder",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["*"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
